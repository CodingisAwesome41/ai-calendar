{
  "expo": {
    "name": "AI Calendar",
    "slug": "ai-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aicalendar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5B5FEF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aicalendar.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "AI Calendar needs access to show and create events on your device calendars including iCloud.",
        "NSRemindersUsageDescription": "AI Calendar may use reminders for event alerts."
      }
    },
    "android": {
      "package": "com.aicalendar.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#5B5FEF"
      },
      "permissions": [
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-calendar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5B5FEF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
